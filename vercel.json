{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/view-reports", "destination": "/public/view-reports.html" },
    { "source": "/portfolio", "destination": "/public/portfolio.html" },
    { "source": "/reports", "destination": "/public/reports.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
