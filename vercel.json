{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/reports",
      "dest": "/api/reports.js"
    },
    {
      "src": "/api/report",
      "dest": "/api/report.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
